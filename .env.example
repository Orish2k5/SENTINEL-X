# TEMPLATE ONLY. Never put real secrets in this file.
# Copy to .env locally and replace values with local development settings.
# .env is ignored by Git.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=sqlite:///./sentinel_x_dev.db
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=replace_locally
MQTT_PASSWORD=replace_locally
# Use a locally generated random test key only; never use a real device key here.
SENTINEL_X_TEST_HMAC_KEY=replace_with_local_test_value
