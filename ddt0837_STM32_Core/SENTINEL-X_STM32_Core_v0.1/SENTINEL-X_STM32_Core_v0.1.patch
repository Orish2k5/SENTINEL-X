diff --git a/firmware/stm32/Core/Src/sx_app_core.c b/firmware/stm32/Core/Src/sx_app_core.c
new file mode 100644
index 0000000000000000000000000000000000000000..a247e366ca5718c61f9404372fd86b8717d38dcb
--- /dev/null
+++ b/firmware/stm32/Core/Src/sx_app_core.c
@@ -0,0 +1,378 @@
+#include "sx_app_core.h"
+
+#include <string.h>
+
+static bool sx_policy_struct_valid(const sx_policy_v1_t *policy);
+
+static sx_app_result_t sx_result(sx_app_core_t *app, sx_app_result_code_t code,
+                                 uint8_t execution_state)
+{
+    sx_app_result_t result;
+    result.result_code = code;
+    result.execution_state = execution_state;
+    result.output_state = app != NULL ? app->output_state : 255u;
+    result.output_level_permille = app != NULL ? app->output_level_permille : 65535u;
+    if ((app != NULL) && (code == SX_APP_RESULT_SUCCESS)) {
+        app->accepted_count++;
+    } else if (app != NULL) {
+        app->rejected_count++;
+    }
+    return result;
+}
+
+static void sx_force_output_off(sx_app_core_t *app)
+{
+    if (app == NULL) {
+        return;
+    }
+    if ((app->output.force_off != NULL)) {
+        app->output.force_off(app->output.context);
+    } else if (app->output.set_level_permille != NULL) {
+        app->output.set_level_permille(app->output.context, 0u);
+    }
+    app->output_state = 0u;
+    app->output_level_permille = 0u;
+}
+
+void sx_app_force_off(sx_app_core_t *app)
+{
+    sx_force_output_off(app);
+}
+
+bool sx_app_core_init(sx_app_core_t *app,
+                      const uint8_t device_id[SX_SIZE_DEVICE_ID],
+                      const sx_sequence_store_t *sequence_store,
+                      const sx_key_provider_t *key_provider,
+                      const sx_crypto_provider_t *crypto_provider,
+                      const sx_policy_store_t *policy_store,
+                      sx_rate_limit_allow_fn rate_limit_allow,
+                      void *rate_limit_context,
+                      const sx_output_interface_t *output)
+{
+    bool sequence_ok;
+
+    if ((app == NULL) || (device_id == NULL) || (sequence_store == NULL) ||
+        (key_provider == NULL) || (crypto_provider == NULL) || (output == NULL)) {
+        return false;
+    }
+
+    (void)memset(app, 0, sizeof(*app));
+    (void)memcpy(app->device_id, device_id, SX_SIZE_DEVICE_ID);
+    app->key_provider = *key_provider;
+    app->crypto_provider = *crypto_provider;
+    app->sequence_store = *sequence_store;
+    app->output = *output;
+    app->rate_limit_allow = rate_limit_allow;
+    app->rate_limit_context = rate_limit_context;
+    app->last_nonzero_level_permille = 1000u;
+    app->output_state = 0u;
+    app->output_level_permille = 0u;
+
+    sequence_ok = sx_replay_guard_init(&app->replay_guard, sequence_store);
+    app->storage_ready = sequence_ok;
+    if (!sequence_ok) {
+        sx_force_output_off(app);
+        return false;
+    }
+
+    if (policy_store != NULL) {
+        app->policy_store = *policy_store;
+        if ((policy_store->load != NULL) && policy_store->load(policy_store->context, &app->active_policy) &&
+            sx_policy_struct_valid(&app->active_policy)) {
+            /* The backend must also validate the FRAM record CRC/generation/commit marker. */
+            app->policy_valid = true;
+        }
+    }
+
+    sx_force_output_off(app);
+    return true;
+}
+
+static bool sx_policy_struct_valid(const sx_policy_v1_t *policy)
+{
+    uint8_t i;
+    uint8_t j;
+
+    if ((policy == NULL) || (policy->version == 0u) ||
+        (policy->max_commands_per_second < 1u) ||
+        (policy->max_commands_per_second > 20u) ||
+        (policy->entry_count < 1u) || (policy->entry_count > 8u) ||
+        ((policy->flags & 0xFEu) != 0u)) {
+        return false;
+    }
+
+    for (i = 0u; i < policy->entry_count; ++i) {
+        const sx_policy_entry_t *entry = &policy->entries[i];
+        bool bounds_valid = false;
+
+        if (entry->allowed > 1u) {
+            return false;
+        }
+        if (entry->min_value > entry->max_value) {
+            return false;
+        }
+        switch (entry->command_code) {
+        case SX_OP_SET_OUTPUT:
+            bounds_valid = entry->max_value <= 1u;
+            break;
+        case SX_OP_SET_LEVEL:
+            bounds_valid = entry->max_value <= 1000u;
+            break;
+        case SX_OP_GET_STATUS:
+            bounds_valid = (entry->min_value == 0u) && (entry->max_value == 0u);
+            break;
+        default:
+            bounds_valid = false;
+            break;
+        }
+        if (!bounds_valid) {
+            return false;
+        }
+        for (j = 0u; j < i; ++j) {
+            if (policy->entries[j].command_code == entry->command_code) {
+                return false;
+            }
+        }
+    }
+    return true;
+}
+
+static bool sx_policy_allows_command(const sx_policy_v1_t *policy,
+                                     const sx_command_t *command)
+{
+    uint8_t i;
+    uint16_t value;
+
+    if ((policy == NULL) || (command == NULL)) {
+        return false;
+    }
+
+    value = command->value;
+    for (i = 0u; i < policy->entry_count; ++i) {
+        const sx_policy_entry_t *entry = &policy->entries[i];
+        if (entry->command_code == command->operation_code) {
+            return (entry->allowed == 1u) &&
+                   (value >= entry->min_value) && (value <= entry->max_value);
+        }
+    }
+    return false;
+}
+
+static bool sx_apply_command(sx_app_core_t *app, const sx_command_t *command)
+{
+    uint16_t level;
+
+    if ((app == NULL) || (command == NULL)) {
+        return false;
+    }
+
+    switch (command->operation_code) {
+    case SX_OP_SET_OUTPUT:
+        if (command->value == 0u) {
+            sx_force_output_off(app);
+            return true;
+        }
+        level = app->last_nonzero_level_permille;
+        if (level == 0u) {
+            level = 1000u;
+        }
+        if (app->output.set_level_permille == NULL) {
+            return false;
+        }
+        app->output.set_level_permille(app->output.context, level);
+        app->output_state = 1u;
+        app->output_level_permille = level;
+        return true;
+
+    case SX_OP_SET_LEVEL:
+        if (command->value == 0u) {
+            sx_force_output_off(app);
+            return true;
+        }
+        if (app->output.set_level_permille == NULL) {
+            return false;
+        }
+        app->output.set_level_permille(app->output.context, command->value);
+        app->last_nonzero_level_permille = command->value;
+        app->output_state = 1u;
+        app->output_level_permille = command->value;
+        return true;
+
+    case SX_OP_GET_STATUS:
+        return true;
+
+    default:
+        return false;
+    }
+}
+
+sx_app_result_t sx_app_process_envelope(sx_app_core_t *app,
+                                        const uint8_t *envelope, size_t envelope_len,
+                                        uint32_t now_ms)
+{
+    sx_envelope_view_t view;
+    sx_envelope_error_t parse_error;
+    sx_command_t command;
+    sx_policy_v1_t new_policy;
+    uint8_t key[SX_DEVICE_KEY_SIZE];
+    sx_replay_result_t replay_result;
+
+    if ((app == NULL) || (envelope == NULL)) {
+        return sx_result(app, SX_APP_RESULT_FRAME_INVALID, 0u);
+    }
+    if (!app->storage_ready || !app->replay_guard.ready) {
+        sx_force_output_off(app);
+        return sx_result(app, SX_APP_RESULT_STORAGE_UNAVAILABLE, 0u);
+    }
+    if (!sx_envelope_parse(envelope, envelope_len, app->device_id, &view, &parse_error)) {
+        if (parse_error == SX_ENVELOPE_ERR_DEVICE_ID) {
+            return sx_result(app, SX_APP_RESULT_DEVICE_MISMATCH, 0u);
+        }
+        if (parse_error == SX_ENVELOPE_ERR_KEY_ID) {
+            return sx_result(app, SX_APP_RESULT_KEY_UNKNOWN, 0u);
+        }
+        if ((parse_error == SX_ENVELOPE_ERR_LENGTH) || (parse_error == SX_ENVELOPE_ERR_PAYLOAD_LENGTH)) {
+            return sx_result(app, SX_APP_RESULT_LENGTH_INVALID, 0u);
+        }
+        return sx_result(app, SX_APP_RESULT_FRAME_INVALID, 0u);
+    }
+
+    if ((app->key_provider.get_key == NULL) ||
+        !app->key_provider.get_key(app->key_provider.context, view.key_id, key)) {
+        volatile uint8_t *wipe = key;
+        size_t i;
+        for (i = 0u; i < sizeof(key); ++i) {
+            wipe[i] = 0u;
+        }
+        return sx_result(app, SX_APP_RESULT_KEY_UNKNOWN, 0u);
+    }
+    if ((app->crypto_provider.verify == NULL) ||
+        (app->crypto_provider.verify(app->crypto_provider.context, key,
+                                     view.authenticated_bytes, view.authenticated_length,
+                                     view.tag) != 1)) {
+        volatile uint8_t *wipe = key;
+        size_t i;
+        for (i = 0u; i < sizeof(key); ++i) {
+            wipe[i] = 0u;
+        }
+        return sx_result(app, SX_APP_RESULT_HMAC_INVALID, 0u);
+    }
+    {
+        volatile uint8_t *wipe = key;
+        size_t i;
+        for (i = 0u; i < sizeof(key); ++i) {
+            wipe[i] = 0u;
+        }
+    }
+
+    if (view.message_type == SX_MSG_CMD) {
+        if (!sx_command_decode(&view, &command, &parse_error)) {
+            return sx_result(app,
+                (view.operation_code == SX_OP_SET_OUTPUT) ||
+                (view.operation_code == SX_OP_SET_LEVEL) ||
+                (view.operation_code == SX_OP_GET_STATUS)
+                    ? SX_APP_RESULT_PAYLOAD_INVALID : SX_APP_RESULT_UNKNOWN_COMMAND,
+                0u);
+        }
+    } else if (view.message_type == SX_MSG_POLICY_UPDATE) {
+        if ((view.operation_code != SX_OP_POLICY_UPDATE) ||
+            !sx_policy_v1_decode(view.payload, view.payload_len,
+                                 app->policy_valid ? app->active_policy.version : 0u,
+                                 &new_policy, &parse_error)) {
+            return sx_result(app, SX_APP_RESULT_PARAMETER_INVALID, 0u);
+        }
+    } else {
+        return sx_result(app, SX_APP_RESULT_FRAME_INVALID, 0u);
+    }
+
+    /* A schema-valid authenticated message consumes its sequence even if policy denies it. */
+    replay_result = sx_replay_guard_consume(&app->replay_guard, view.sequence);
+    if (replay_result == SX_REPLAY_REJECTED) {
+        return sx_result(app, SX_APP_RESULT_REPLAY, 0u);
+    }
+    if (replay_result != SX_REPLAY_ACCEPTED) {
+        app->storage_ready = false;
+        sx_force_output_off(app);
+        return sx_result(app, SX_APP_RESULT_PERSISTENCE_FAILED, 0u);
+    }
+
+    if (view.message_type == SX_MSG_POLICY_UPDATE) {
+        if ((app->policy_store.commit == NULL) ||
+            !app->policy_store.commit(app->policy_store.context, &new_policy)) {
+            app->policy_valid = false;
+            sx_force_output_off(app);
+            return sx_result(app, SX_APP_RESULT_PERSISTENCE_FAILED, 0u);
+        }
+        app->active_policy = new_policy;
+        app->policy_valid = true;
+        return sx_result(app, SX_APP_RESULT_SUCCESS, 1u);
+    }
+
+    if ((command.operation_code != SX_OP_GET_STATUS) &&
+        (!app->link_seen || !app->link_online ||
+         ((uint32_t)(now_ms - app->last_link_status_ms) > SX_LINK_TIMEOUT_MS))) {
+        sx_force_output_off(app);
+        return sx_result(app, SX_APP_RESULT_LINK_OFFLINE, 0u);
+    }
+
+    if (!app->policy_valid) {
+        /* Contract allows authenticated GET_STATUS while policy is absent; actuation stays OFF. */
+        if (command.operation_code == SX_OP_GET_STATUS) {
+            return sx_result(app, SX_APP_RESULT_SUCCESS, 1u);
+        }
+        return sx_result(app, SX_APP_RESULT_SAFE_MODE, 0u);
+    }
+
+    if (!sx_policy_allows_command(&app->active_policy, &command)) {
+        return sx_result(app, SX_APP_RESULT_COMMAND_DENIED, 0u);
+    }
+
+    if (command.operation_code != SX_OP_GET_STATUS) {
+        if ((app->rate_limit_allow == NULL) ||
+            !app->rate_limit_allow(app->rate_limit_context, now_ms,
+                                   app->active_policy.max_commands_per_second)) {
+            return sx_result(app, SX_APP_RESULT_RATE_LIMITED, 0u);
+        }
+    }
+
+    if (!sx_apply_command(app, &command)) {
+        sx_force_output_off(app);
+        return sx_result(app, SX_APP_RESULT_PARAMETER_INVALID, 0u);
+    }
+    return sx_result(app, SX_APP_RESULT_SUCCESS, 1u);
+}
+
+void sx_app_process_link_status(sx_app_core_t *app, const uint8_t payload[7],
+                                uint32_t now_ms)
+{
+    if ((app == NULL) || (payload == NULL)) {
+        return;
+    }
+
+    if ((payload[0] > 1u) || (payload[1] > 1u) || (payload[2] != 0u)) {
+        app->link_online = false;
+        sx_force_output_off(app);
+        return;
+    }
+
+    app->link_seen = true;
+    app->link_online = (payload[0] == 1u) && (payload[1] == 1u);
+    app->last_link_status_ms = now_ms;
+    if (!app->link_online) {
+        sx_force_output_off(app);
+    }
+}
+
+void sx_app_tick(sx_app_core_t *app, uint32_t now_ms)
+{
+    if (app == NULL) {
+        return;
+    }
+    if (!app->link_seen || ((uint32_t)(now_ms - app->last_link_status_ms) > SX_LINK_TIMEOUT_MS) ||
+        !app->link_online) {
+        sx_force_output_off(app);
+    }
+    if (!app->storage_ready || !app->replay_guard.ready) {
+        sx_force_output_off(app);
+    }
+}
diff --git a/firmware/stm32/Core/Src/sx_crypto_mbedtls.c b/firmware/stm32/Core/Src/sx_crypto_mbedtls.c
new file mode 100644
index 0000000000000000000000000000000000000000..b0eef899a8cd7d5775d60e07f5257a571ee7b4a6
--- /dev/null
+++ b/firmware/stm32/Core/Src/sx_crypto_mbedtls.c
@@ -0,0 +1,65 @@
+#include "sx_crypto_mbedtls.h"
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include "mbedtls/md.h"
+
+static void sx_secure_zero(void *memory, size_t length)
+{
+    volatile uint8_t *p = (volatile uint8_t *)memory;
+    while (length > 0u) {
+        *p = 0u;
+        ++p;
+        --length;
+    }
+}
+
+static int sx_constant_time_equal_32(const uint8_t a[32], const uint8_t b[32])
+{
+    uint8_t difference = 0u;
+    size_t i;
+
+    for (i = 0u; i < 32u; ++i) {
+        difference |= (uint8_t)(a[i] ^ b[i]);
+    }
+    return difference == 0u ? 1 : 0;
+}
+
+int sx_crypto_verify_hmac_sha256(const uint8_t *key, size_t key_len,
+                                 const uint8_t *authenticated_bytes, size_t authenticated_len,
+                                 const uint8_t received_tag[32])
+{
+    const mbedtls_md_info_t *md_info;
+    uint8_t calculated_tag[32];
+    int valid = 0;
+
+    if ((key == NULL) || (authenticated_bytes == NULL) || (received_tag == NULL) ||
+        (key_len != 32u)) {
+        return 0;
+    }
+
+    md_info = mbedtls_md_info_from_type(MBEDTLS_MD_SHA256);
+    if (md_info == NULL) {
+        return 0;
+    }
+
+    if (mbedtls_md_hmac(md_info, key, key_len, authenticated_bytes,
+                        authenticated_len, calculated_tag) == 0) {
+        valid = sx_constant_time_equal_32(calculated_tag, received_tag);
+    }
+
+    sx_secure_zero(calculated_tag, sizeof(calculated_tag));
+    return valid;
+}
+
+int sx_crypto_mbedtls_verify_callback(void *context,
+                                      const uint8_t key[32],
+                                      const uint8_t *authenticated_bytes,
+                                      size_t authenticated_len,
+                                      const uint8_t received_tag[32])
+{
+    (void)context;
+    return sx_crypto_verify_hmac_sha256(key, 32u, authenticated_bytes,
+                                        authenticated_len, received_tag);
+}
diff --git a/firmware/stm32/Core/Src/sx_envelope.c b/firmware/stm32/Core/Src/sx_envelope.c
new file mode 100644
index 0000000000000000000000000000000000000000..c7177fab5c2f134e1f35f0df125744c6e2bcaa0a
--- /dev/null
+++ b/firmware/stm32/Core/Src/sx_envelope.c
@@ -0,0 +1,251 @@
+#include "sx_envelope.h"
+
+#include <string.h>
+
+static uint16_t sx_read_u16_be(const uint8_t *p)
+{
+    return (uint16_t)(((uint16_t)p[0] << 8) | p[1]);
+}
+
+static uint32_t sx_read_u32_be(const uint8_t *p)
+{
+    return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) |
+           ((uint32_t)p[2] << 8) | (uint32_t)p[3];
+}
+
+static uint64_t sx_read_u64_be(const uint8_t *p)
+{
+    uint64_t value = 0u;
+    uint8_t i;
+    for (i = 0u; i < 8u; ++i) {
+        value = (value << 8) | (uint64_t)p[i];
+    }
+    return value;
+}
+
+static void sx_set_error(sx_envelope_error_t *error, sx_envelope_error_t value)
+{
+    if (error != NULL) {
+        *error = value;
+    }
+}
+
+void sx_device_id_make(uint8_t output[SX_SIZE_DEVICE_ID], const char *ascii_id)
+{
+    size_t i;
+
+    if (output == NULL) {
+        return;
+    }
+    (void)memset(output, 0, SX_SIZE_DEVICE_ID);
+    if (ascii_id == NULL) {
+        return;
+    }
+    for (i = 0u; (i < SX_SIZE_DEVICE_ID) && (ascii_id[i] != '\0'); ++i) {
+        output[i] = (uint8_t)ascii_id[i];
+    }
+}
+
+bool sx_envelope_parse(
+    const uint8_t *bytes,
+    size_t length,
+    const uint8_t expected_device_id[SX_SIZE_DEVICE_ID],
+    sx_envelope_view_t *view,
+    sx_envelope_error_t *error)
+{
+    uint16_t payload_len;
+    size_t expected_length;
+
+    if ((bytes == NULL) || (expected_device_id == NULL) || (view == NULL)) {
+        sx_set_error(error, SX_ENVELOPE_ERR_ARGUMENT);
+        return false;
+    }
+    if ((length < (SX_ENVELOPE_HEADER_SIZE + SX_ENVELOPE_TAG_SIZE)) ||
+        (length > SX_ENVELOPE_MAX_SIZE)) {
+        sx_set_error(error, SX_ENVELOPE_ERR_LENGTH);
+        return false;
+    }
+    if ((bytes[SX_OFF_MAGIC] != SX_ENVELOPE_MAGIC_0) ||
+        (bytes[SX_OFF_MAGIC + 1u] != SX_ENVELOPE_MAGIC_1)) {
+        sx_set_error(error, SX_ENVELOPE_ERR_MAGIC);
+        return false;
+    }
+    if (bytes[SX_OFF_PROTOCOL_VERSION] != SX_PROTOCOL_VERSION) {
+        sx_set_error(error, SX_ENVELOPE_ERR_VERSION);
+        return false;
+    }
+    if ((bytes[SX_OFF_MESSAGE_TYPE] != SX_MSG_CMD) &&
+        (bytes[SX_OFF_MESSAGE_TYPE] != SX_MSG_POLICY_UPDATE)) {
+        sx_set_error(error, SX_ENVELOPE_ERR_MESSAGE_TYPE);
+        return false;
+    }
+    if (memcmp(&bytes[SX_OFF_DEVICE_ID], expected_device_id, SX_SIZE_DEVICE_ID) != 0) {
+        sx_set_error(error, SX_ENVELOPE_ERR_DEVICE_ID);
+        return false;
+    }
+    if (bytes[SX_OFF_KEY_ID] != 1u) {
+        sx_set_error(error, SX_ENVELOPE_ERR_KEY_ID);
+        return false;
+    }
+
+    payload_len = sx_read_u16_be(&bytes[SX_OFF_PAYLOAD_LEN]);
+    if (payload_len > SX_ENVELOPE_MAX_PAYLOAD) {
+        sx_set_error(error, SX_ENVELOPE_ERR_PAYLOAD_LENGTH);
+        return false;
+    }
+    expected_length = (size_t)SX_ENVELOPE_HEADER_SIZE + (size_t)payload_len + SX_ENVELOPE_TAG_SIZE;
+    if (length != expected_length) {
+        sx_set_error(error, SX_ENVELOPE_ERR_PAYLOAD_LENGTH);
+        return false;
+    }
+
+    view->message_type = bytes[SX_OFF_MESSAGE_TYPE];
+    view->key_id = bytes[SX_OFF_KEY_ID];
+    view->sequence = sx_read_u64_be(&bytes[SX_OFF_SEQUENCE]);
+    view->message_id = &bytes[SX_OFF_MESSAGE_ID];
+    view->operation_code = sx_read_u16_be(&bytes[SX_OFF_OPERATION_CODE]);
+    view->payload_len = payload_len;
+    view->payload = &bytes[SX_OFF_PAYLOAD];
+    view->tag = &bytes[SX_OFF_PAYLOAD + payload_len];
+    view->authenticated_bytes = bytes;
+    view->authenticated_length = (size_t)SX_ENVELOPE_HEADER_SIZE + payload_len;
+    sx_set_error(error, SX_ENVELOPE_OK);
+    return true;
+}
+
+bool sx_command_decode(const sx_envelope_view_t *view, sx_command_t *command,
+                       sx_envelope_error_t *error)
+{
+    if ((view == NULL) || (command == NULL) || (view->message_type != SX_MSG_CMD)) {
+        sx_set_error(error, SX_ENVELOPE_ERR_ARGUMENT);
+        return false;
+    }
+
+    (void)memset(command, 0, sizeof(*command));
+    command->operation_code = view->operation_code;
+
+    switch (view->operation_code) {
+    case SX_OP_SET_OUTPUT:
+        if ((view->payload_len != 2u) || (view->payload[0] != 1u) || (view->payload[1] > 1u)) {
+            sx_set_error(error, SX_ENVELOPE_ERR_COMMAND);
+            return false;
+        }
+        command->selector = view->payload[0];
+        command->value = view->payload[1];
+        break;
+
+    case SX_OP_SET_LEVEL:
+        if ((view->payload_len != 3u) || (view->payload[0] != 1u)) {
+            sx_set_error(error, SX_ENVELOPE_ERR_COMMAND);
+            return false;
+        }
+        command->selector = view->payload[0];
+        command->value = sx_read_u16_be(&view->payload[1]);
+        if (command->value > 1000u) {
+            sx_set_error(error, SX_ENVELOPE_ERR_COMMAND);
+            return false;
+        }
+        break;
+
+    case SX_OP_GET_STATUS:
+        if (view->payload_len != 0u) {
+            sx_set_error(error, SX_ENVELOPE_ERR_COMMAND);
+            return false;
+        }
+        break;
+
+    default:
+        sx_set_error(error, SX_ENVELOPE_ERR_COMMAND);
+        return false;
+    }
+
+    sx_set_error(error, SX_ENVELOPE_OK);
+    return true;
+}
+
+static bool sx_policy_entry_bounds_valid(uint16_t code, uint16_t min_value, uint16_t max_value)
+{
+    if (min_value > max_value) {
+        return false;
+    }
+    switch (code) {
+    case SX_OP_SET_OUTPUT:
+        return max_value <= 1u;
+    case SX_OP_SET_LEVEL:
+        return max_value <= 1000u;
+    case SX_OP_GET_STATUS:
+        return (min_value == 0u) && (max_value == 0u);
+    default:
+        return false;
+    }
+}
+
+bool sx_policy_v1_decode(const uint8_t *payload, uint16_t payload_len,
+                         uint32_t active_policy_version, sx_policy_v1_t *policy,
+                         sx_envelope_error_t *error)
+{
+    uint8_t i;
+    uint8_t j;
+    uint8_t count;
+    uint32_t version;
+    uint16_t rate;
+    uint8_t flags;
+    uint16_t expected_len;
+
+    if ((payload == NULL) || (policy == NULL)) {
+        sx_set_error(error, SX_ENVELOPE_ERR_ARGUMENT);
+        return false;
+    }
+    if (payload_len < 15u) {
+        sx_set_error(error, SX_ENVELOPE_ERR_POLICY);
+        return false;
+    }
+
+    version = sx_read_u32_be(&payload[0]);
+    rate = sx_read_u16_be(&payload[4]);
+    count = payload[6];
+    flags = payload[7];
+
+    if ((version <= active_policy_version) || (rate < 1u) || (rate > 20u) ||
+        (count < 1u) || (count > 8u) || ((flags & 0xFEu) != 0u)) {
+        sx_set_error(error, SX_ENVELOPE_ERR_POLICY);
+        return false;
+    }
+
+    expected_len = (uint16_t)(8u + (uint16_t)(7u * count));
+    if ((payload_len != expected_len) || (payload_len > 64u)) {
+        sx_set_error(error, SX_ENVELOPE_ERR_POLICY);
+        return false;
+    }
+
+    (void)memset(policy, 0, sizeof(*policy));
+    policy->version = version;
+    policy->max_commands_per_second = rate;
+    policy->entry_count = count;
+    policy->flags = flags;
+
+    for (i = 0u; i < count; ++i) {
+        const uint8_t *entry_bytes = &payload[8u + (uint16_t)(7u * i)];
+        sx_policy_entry_t *entry = &policy->entries[i];
+
+        entry->command_code = sx_read_u16_be(&entry_bytes[0]);
+        entry->allowed = entry_bytes[2];
+        entry->min_value = sx_read_u16_be(&entry_bytes[3]);
+        entry->max_value = sx_read_u16_be(&entry_bytes[5]);
+
+        if ((entry->allowed > 1u) ||
+            !sx_policy_entry_bounds_valid(entry->command_code, entry->min_value, entry->max_value)) {
+            sx_set_error(error, SX_ENVELOPE_ERR_POLICY);
+            return false;
+        }
+        for (j = 0u; j < i; ++j) {
+            if (policy->entries[j].command_code == entry->command_code) {
+                sx_set_error(error, SX_ENVELOPE_ERR_POLICY);
+                return false;
+            }
+        }
+    }
+
+    sx_set_error(error, SX_ENVELOPE_OK);
+    return true;
+}
diff --git a/firmware/stm32/Core/Src/sx_platform_port_template.c b/firmware/stm32/Core/Src/sx_platform_port_template.c
new file mode 100644
index 0000000000000000000000000000000000000000..598f69bf49d74e1b24d4d143aa598af01e31e7c3
--- /dev/null
+++ b/firmware/stm32/Core/Src/sx_platform_port_template.c
@@ -0,0 +1,79 @@
+#include "sx_platform_port.h"
+#include "sx_crypto_mbedtls.h"
+
+/*
+ * Deliberately fail-closed template. Replace each function with the selected
+ * FRAM/key-provisioning/rate-limit implementation. Do not return a fabricated
+ * sequence value of zero and do not embed a test key here.
+ */
+
+bool SX_Platform_SequenceLoad(void *context, uint64_t *high_water_mark)
+{
+    (void)context;
+    (void)high_water_mark;
+    return false;
+}
+
+bool SX_Platform_SequenceCommit(void *context, uint64_t high_water_mark)
+{
+    (void)context;
