diff --git a/firmware/stm32/Core/Inc/sx_envelope.h b/firmware/stm32/Core/Inc/sx_envelope.h
new file mode 100644
index 0000000000000000000000000000000000000000..70eef76c02640fa724296f0315926ea9b94fcd9f
--- /dev/null
