diff --git a/firmware/stm32/Core/Src/sx_replay_guard.c b/firmware/stm32/Core/Src/sx_replay_guard.c
new file mode 100644
index 0000000000000000000000000000000000000000..250022bd15c775ed0f902a3b67b71ba5ad43f476
--- /dev/null
+++ b/firmware/stm32/Core/Src/sx_replay_guard.c
@@ -0,0 +1,50 @@
+#include "sx_replay_guard.h"
+
+#include <string.h>
+
+bool sx_replay_guard_init(sx_replay_guard_t *guard, const sx_sequence_store_t *store)
+{
+    uint64_t high_water_mark = 0u;
+
+    if ((guard == NULL) || (store == NULL) || (store->load == NULL) || (store->commit == NULL)) {
+        return false;
+    }
+
+    (void)memset(guard, 0, sizeof(*guard));
+    guard->store = *store;
+    if (!guard->store.load(guard->store.context, &high_water_mark)) {
+        guard->ready = false;
+        return false;
+    }
+
+    guard->high_water_mark = high_water_mark;
+    guard->ready = true;
+    return true;
+}
+
+sx_replay_result_t sx_replay_guard_consume(sx_replay_guard_t *guard, uint64_t sequence)
+{
+    if ((guard == NULL) || !guard->ready || (guard->store.commit == NULL)) {
+        return SX_REPLAY_STORAGE_ERROR;
+    }
+    if (sequence <= guard->high_water_mark) {
+        return SX_REPLAY_REJECTED;
+    }
+
+    /* Commit before changing RAM state and, critically, before actuator execution. */
+    if (!guard->store.commit(guard->store.context, sequence)) {
+        guard->ready = false;
+        return SX_REPLAY_STORAGE_ERROR;
+    }
+
+    guard->high_water_mark = sequence;
+    return SX_REPLAY_ACCEPTED;
+}
+
+uint64_t sx_replay_guard_high_water(const sx_replay_guard_t *guard)
+{
+    if (guard == NULL) {
+        return 0u;
+    }
+    return guard->high_water_mark;
+}
diff --git a/firmware/stm32/Core/Src/sx_ring_buffer.c b/firmware/stm32/Core/Src/sx_ring_buffer.c
new file mode 100644
index 0000000000000000000000000000000000000000..e61aadbb19b66242e96b14249bb3fdb5242b1acf
--- /dev/null
+++ b/firmware/stm32/Core/Src/sx_ring_buffer.c
@@ -0,0 +1,64 @@
+#include "sx_ring_buffer.h"
+
+#include <string.h>
+
+#define SX_RING_MASK (SX_UART_RX_RING_CAPACITY - 1u)
+
+#if ((SX_UART_RX_RING_CAPACITY & (SX_UART_RX_RING_CAPACITY - 1u)) != 0u)
+#error "SX_UART_RX_RING_CAPACITY must be a power of two"
+#endif
+
+void sx_byte_ring_init(sx_byte_ring_t *ring)
+{
+    if (ring != NULL) {
+        (void)memset(ring, 0, sizeof(*ring));
+    }
+}
+
+bool sx_byte_ring_push_isr(sx_byte_ring_t *ring, uint8_t byte)
+{
+    uint16_t next;
+
+    if (ring == NULL) {
+        return false;
+    }
+    next = (uint16_t)((ring->head + 1u) & SX_RING_MASK);
+    if (next == ring->tail) {
+        ring->overflow = true;
+        return false;
+    }
+    ring->bytes[ring->head] = byte;
+    /* Publish the byte before publishing the new head index. */
+#if defined(__GNUC__)
+    __atomic_thread_fence(__ATOMIC_RELEASE);
+#endif
+    ring->head = next;
+    return true;
+}
+
+bool sx_byte_ring_pop(sx_byte_ring_t *ring, uint8_t *byte)
+{
+    if ((ring == NULL) || (byte == NULL) || (ring->tail == ring->head)) {
+        return false;
+    }
+#if defined(__GNUC__)
+    __atomic_thread_fence(__ATOMIC_ACQUIRE);
+#endif
+    *byte = ring->bytes[ring->tail];
+#if defined(__GNUC__)
+    __atomic_thread_fence(__ATOMIC_RELEASE);
+#endif
+    ring->tail = (uint16_t)((ring->tail + 1u) & SX_RING_MASK);
+    return true;
+}
+
+bool sx_byte_ring_take_overflow(sx_byte_ring_t *ring)
+{
+    bool overflow;
+    if (ring == NULL) {
+        return false;
+    }
+    overflow = ring->overflow;
+    ring->overflow = false;
+    return overflow;
+}
diff --git a/firmware/stm32/Core/Src/sx_stm32_adapter.c b/firmware/stm32/Core/Src/sx_stm32_adapter.c
new file mode 100644
index 0000000000000000000000000000000000000000..05d0b55b1c8cb3c418de2d0ed9d1260c23492fd0
--- /dev/null
+++ b/firmware/stm32/Core/Src/sx_stm32_adapter.c
@@ -0,0 +1,133 @@
+#include "sx_stm32_adapter.h"
+
+#include "sx_ring_buffer.h"
+#include "sx_uart_frame.h"
+
+extern UART_HandleTypeDef huart1;
+extern TIM_HandleTypeDef htim3;
+
+static uint8_t sx_uart_rx_byte;
+static sx_byte_ring_t sx_uart_rx_ring;
+static sx_uart_parser_t sx_uart_parser;
+static bool sx_uart_adapter_initialized;
+static volatile uint32_t sx_last_rx_byte_ms;
+
+static void sx_output_hal_off(void *context)
+{
+    (void)context;
+    __HAL_TIM_SET_COMPARE(&htim3, TIM_CHANNEL_3, 0u);
+    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_0, GPIO_PIN_RESET);
+}
+
+static void sx_output_hal_set_level(void *context, uint16_t level_permille)
+{
+    uint32_t arr;
+    uint32_t compare;
+    (void)context;
+
+    if (level_permille == 0u) {
+        sx_output_hal_off(NULL);
+        return;
+    }
+
+    arr = __HAL_TIM_GET_AUTORELOAD(&htim3);
+    compare = ((arr + 1u) * (uint32_t)level_permille) / 1000u;
+    if (compare > 65535u) {
+        compare = 65535u;
+    }
+    __HAL_TIM_SET_COMPARE(&htim3, TIM_CHANNEL_3, compare);
+}
+
+void SX_STM32_ForceOutputOffEarly(void)
+{
+    GPIO_InitTypeDef gpio = {0};
+
+    __HAL_RCC_GPIOB_CLK_ENABLE();
+    /* Preload ODR low before switching PB0 to output mode. */
+    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_0, GPIO_PIN_RESET);
+    gpio.Pin = GPIO_PIN_0;
+    gpio.Mode = GPIO_MODE_OUTPUT_PP;
+    gpio.Pull = GPIO_NOPULL;
+    gpio.Speed = GPIO_SPEED_FREQ_LOW;
+    HAL_GPIO_Init(GPIOB, &gpio);
+}
+
+HAL_StatusTypeDef SX_STM32_InitOutputSafe(void)
+{
+    __HAL_TIM_SET_COMPARE(&htim3, TIM_CHANNEL_3, 0u);
+    sx_output_hal_off(NULL);
+    return HAL_TIM_PWM_Start(&htim3, TIM_CHANNEL_3);
+}
+
+void SX_STM32_GetOutputInterface(sx_output_interface_t *output)
+{
+    if (output == NULL) {
+        return;
+    }
+    output->context = NULL;
+    output->force_off = sx_output_hal_off;
+    output->set_level_permille = sx_output_hal_set_level;
+}
+
+HAL_StatusTypeDef SX_STM32_StartUartRx(void)
+{
+    sx_byte_ring_init(&sx_uart_rx_ring);
+    sx_uart_parser_init(&sx_uart_parser);
+    sx_uart_adapter_initialized = true;
+    return HAL_UART_Receive_IT(&huart1, &sx_uart_rx_byte, 1u);
+}
+
+void SX_STM32_UartRxCompleteCallback(UART_HandleTypeDef *huart)
+{
+    if ((huart == NULL) || (huart->Instance != USART1) || !sx_uart_adapter_initialized) {
+        return;
+    }
+    if (!sx_byte_ring_push_isr(&sx_uart_rx_ring, sx_uart_rx_byte)) {
+        /* Overflow is handled in foreground; no parsing, crypto or actuation in this callback. */
+    }
+    sx_last_rx_byte_ms = HAL_GetTick();
+    (void)HAL_UART_Receive_IT(&huart1, &sx_uart_rx_byte, 1u);
+}
+
+void SX_STM32_UartErrorCallback(UART_HandleTypeDef *huart)
+{
+    if ((huart == NULL) || (huart->Instance != USART1) || !sx_uart_adapter_initialized) {
+        return;
+    }
+    sx_uart_rx_ring.overflow = true;
+    (void)HAL_UART_AbortReceive(&huart1);
+    (void)HAL_UART_Receive_IT(&huart1, &sx_uart_rx_byte, 1u);
+}
+
+void SX_STM32_Process(sx_app_core_t *app, uint32_t now_ms)
+{
+    uint8_t byte;
+    sx_uart_frame_t frame;
+
+    if ((app == NULL) || !sx_uart_adapter_initialized) {
+        return;
+    }
+
+    if (sx_byte_ring_take_overflow(&sx_uart_rx_ring)) {
+        sx_uart_parser_reset(&sx_uart_parser);
+        sx_app_force_off(app);
+    }
+    if (sx_uart_parser_is_active(&sx_uart_parser) &&
+        ((uint32_t)(now_ms - sx_last_rx_byte_ms) > SX_UART_FRAME_TIMEOUT_MS)) {
+        sx_uart_parser_reset(&sx_uart_parser);
+    }
+
+    while (sx_byte_ring_pop(&sx_uart_rx_ring, &byte)) {
+        sx_uart_parse_result_t parsed = sx_uart_parser_feed(&sx_uart_parser, byte, &frame);
+        if (parsed == SX_UART_PARSE_COMPLETE) {
+            if (frame.frame_type == SX_UART_FRAME_LINK_STATUS) {
+                sx_app_process_link_status(app, frame.payload, now_ms);
+            } else if (frame.frame_type == SX_UART_FRAME_AUTH_ENVELOPE) {
+                /* HMAC, sequence persistence and command handling run in foreground context. */
+                (void)sx_app_process_envelope(app, frame.payload, frame.payload_len, now_ms);
+            }
+        }
+    }
+
+    sx_app_tick(app, now_ms);
+}
diff --git a/firmware/stm32/Core/Src/sx_uart_frame.c b/firmware/stm32/Core/Src/sx_uart_frame.c
new file mode 100644
index 0000000000000000000000000000000000000000..eecea12ecf458024997eb6e6299f051421ed0816
--- /dev/null
+++ b/firmware/stm32/Core/Src/sx_uart_frame.c
@@ -0,0 +1,175 @@
+#include "sx_uart_frame.h"
+
+#include <string.h>
+
+enum {
+    SX_PARSE_WAIT_SOF_1 = 0,
+    SX_PARSE_WAIT_SOF_2,
+    SX_PARSE_FRAME_TYPE,
+    SX_PARSE_LENGTH_HI,
+    SX_PARSE_LENGTH_LO,
+    SX_PARSE_PAYLOAD,
+    SX_PARSE_CRC_HI,
+    SX_PARSE_CRC_LO
+};
+
+static uint16_t sx_crc_update(uint16_t crc, uint8_t byte)
+{
+    uint8_t bit;
+
+    crc ^= (uint16_t)((uint16_t)byte << 8);
+    for (bit = 0u; bit < 8u; ++bit) {
+        if ((crc & 0x8000u) != 0u) {
+            crc = (uint16_t)((crc << 1) ^ SX_CRC16_CCITT_FALSE_POLY);
+        } else {
+            crc = (uint16_t)(crc << 1);
+        }
+    }
+    return crc;
+}
+
+uint16_t sx_crc16_ccitt_false(const uint8_t *data, size_t length)
+{
+    size_t i;
+    uint16_t crc = SX_CRC16_CCITT_FALSE_INIT;
+
+    if ((data == NULL) && (length != 0u)) {
+        return 0u;
+    }
+
+    for (i = 0u; i < length; ++i) {
+        crc = sx_crc_update(crc, data[i]);
+    }
+    return (uint16_t)(crc ^ SX_CRC16_CCITT_FALSE_XOROUT);
+}
+
+void sx_uart_parser_init(sx_uart_parser_t *parser)
+{
+    if (parser != NULL) {
+        (void)memset(parser, 0, sizeof(*parser));
+        parser->state = SX_PARSE_WAIT_SOF_1;
+        parser->crc_running = SX_CRC16_CCITT_FALSE_INIT;
+    }
+}
+
+void sx_uart_parser_reset(sx_uart_parser_t *parser)
+{
+    uint32_t errors;
+
+    if (parser == NULL) {
+        return;
+    }
+
+    errors = parser->error_count;
+    (void)memset(parser, 0, sizeof(*parser));
+    parser->state = SX_PARSE_WAIT_SOF_1;
+    parser->crc_running = SX_CRC16_CCITT_FALSE_INIT;
+    parser->error_count = errors;
+}
+
+bool sx_uart_parser_is_active(const sx_uart_parser_t *parser)
+{
+    return (parser != NULL) && (parser->state != SX_PARSE_WAIT_SOF_1);
+}
+
+static sx_uart_parse_result_t sx_parser_error(sx_uart_parser_t *parser)
+{
+    if (parser != NULL) {
+        parser->error_count++;
+        sx_uart_parser_reset(parser);
+    }
+    return SX_UART_PARSE_ERROR;
+}
+
+static bool sx_valid_frame_length(uint8_t frame_type, uint16_t payload_len)
+{
+    if (frame_type == SX_UART_FRAME_AUTH_ENVELOPE) {
+        return (payload_len >= 81u) && (payload_len <= SX_UART_FRAME_PAYLOAD_CAPACITY);
+    }
+    if (frame_type == SX_UART_FRAME_LINK_STATUS) {
+        return payload_len == 7u;
+    }
+    return false;
+}
+
+sx_uart_parse_result_t sx_uart_parser_feed(
+    sx_uart_parser_t *parser,
+    uint8_t byte,
+    sx_uart_frame_t *completed_frame)
+{
+    if ((parser == NULL) || (completed_frame == NULL)) {
+        return SX_UART_PARSE_ERROR;
+    }
+
+    switch (parser->state) {
+    case SX_PARSE_WAIT_SOF_1:
+        if (byte == SX_UART_SOF_0) {
+            parser->state = SX_PARSE_WAIT_SOF_2;
+        }
+        break;
+
+    case SX_PARSE_WAIT_SOF_2:
+        if (byte == SX_UART_SOF_1) {
+            parser->state = SX_PARSE_FRAME_TYPE;
+            parser->crc_running = SX_CRC16_CCITT_FALSE_INIT;
+        } else if (byte == SX_UART_SOF_0) {
+            /* Keep the latest 0xA5 as a possible start of frame. */
+            parser->state = SX_PARSE_WAIT_SOF_2;
+        } else {
+            parser->state = SX_PARSE_WAIT_SOF_1;
+        }
+        break;
+
+    case SX_PARSE_FRAME_TYPE:
+        parser->frame_type = byte;
+        parser->crc_running = sx_crc_update(parser->crc_running, byte);
+        parser->state = SX_PARSE_LENGTH_HI;
+        break;
+
+    case SX_PARSE_LENGTH_HI:
+        parser->length_hi = byte;
+        parser->crc_running = sx_crc_update(parser->crc_running, byte);
+        parser->state = SX_PARSE_LENGTH_LO;
+        break;
+
+    case SX_PARSE_LENGTH_LO:
+        parser->crc_running = sx_crc_update(parser->crc_running, byte);
+        parser->payload_len = (uint16_t)(((uint16_t)parser->length_hi << 8) | byte);
+        parser->payload_index = 0u;
+        if (!sx_valid_frame_length(parser->frame_type, parser->payload_len)) {
+            return sx_parser_error(parser);
+        }
+        parser->state = SX_PARSE_PAYLOAD;
+        break;
+
+    case SX_PARSE_PAYLOAD:
+        parser->payload[parser->payload_index] = byte;
+        parser->payload_index++;
+        parser->crc_running = sx_crc_update(parser->crc_running, byte);
+        if (parser->payload_index == parser->payload_len) {
+            parser->state = SX_PARSE_CRC_HI;
+        }
+        break;
+
+    case SX_PARSE_CRC_HI:
+        parser->crc_received = (uint16_t)((uint16_t)byte << 8);
+        parser->state = SX_PARSE_CRC_LO;
+        break;
+
+    case SX_PARSE_CRC_LO:
+        parser->crc_received |= byte;
+        if (parser->crc_received != parser->crc_running) {
+            return sx_parser_error(parser);
+        }
+        completed_frame->frame_type = parser->frame_type;
+        completed_frame->payload_len = parser->payload_len;
+        (void)memcpy(completed_frame->payload, parser->payload, parser->payload_len);
+        sx_uart_parser_reset(parser);
+        return SX_UART_PARSE_COMPLETE;
+
+    default:
+        return sx_parser_error(parser);
+    }
+
+    return SX_UART_PARSE_NONE;
+}
diff --git a/firmware/stm32/README.md b/firmware/stm32/README.md
index 61e00996557ca8f2dee3796030fc64392320ebf9..5734961e7f50cca8235a7d8bb1b4a747686e69ad 100644
--- a/firmware/stm32/README.md
+++ b/firmware/stm32/README.md
@@ -1,3 +1,47 @@
-# STM32F411RE firmware
+# STM32F411RE firmware — initial core
 
-STM32CubeIDE project and MCU-side security enforcement. Keep hardware-specific pin assignments marked `PROPOSED` until verified against the actual board/module and tested on hardware. Do not commit generated `Debug/`, `Release/`, ELF, HEX or BIN outputs.
+This folder contains the first MCU-side implementation slice for SENTINEL-X. It is intended to be copied into a **STM32CubeIDE project generated for NUCLEO-F411RE / STM32F411RETx**. It is not a complete, self-contained CubeIDE project: CubeIDE must generate the startup code, linker script, CMSIS files, STM32F4 HAL and the `.ioc` for the local installed Cube firmware package.
+
+## Implemented in this slice
+
+- UART frame parser: SOF `A5 5A`, type/length validation, CRC-16/CCITT-FALSE, bounded payload storage and a proposed 100 ms partial-frame timeout (confirm with ESP32 timing).
+- EnvelopeV1 structural parser: version, direction, device ID, key ID, payload length, big-endian sequence and operation code.
+- Command payload validation for `SET_OUTPUT`, `SET_LEVEL`, `GET_STATUS`.
+- PolicyV1 payload validation, including version monotonicity, entry count, reserved flags, duplicate command rejection and absolute bounds.
+- HMAC-SHA-256 verification adapter for Mbed TLS, using a constant-time 32-byte tag comparison.
+- Replay guard with a persistent-storage callback. It commits the high-water mark before any output callback and fails closed on read/write failure.
+- MCU foreground processing core, link-status timeout handling and an interrupt-fed UART byte ring.
+- STM32 HAL adapter for PB0 / TIM3_CH3 PWM, USART1 interrupt RX, and early output-low initialization.
+- Host tests for CRC, UART parser, EnvelopeV1, command schemas, PolicyV1, replay persistence ordering, safe-mode behavior and the public HMAC vector.
+
+## Not implemented / hardware-dependent
+
+- CubeIDE-generated `.ioc`, startup code, linker script and HAL/CMSIS libraries.
+- Concrete FRAM part selection and its two-slot journal driver. The sequence and policy stores are interfaces only; do not replace them with RAM counters.
+- Real 32-byte device-key provisioning and the key-provider implementation. No real or test HMAC key is included in firmware.
+- Mbed TLS source/library integration and target compilation of `sx_crypto_mbedtls.c`.
+- ACK/EVENT/STATUS Envelope generation and UART TX path.
+- Final rate-limit algorithm selection. The contracts have a fixed-window/token-bucket discrepancy; the current core requires a rate-limit callback and denies actuator commands when it is absent.
+- Physical validation of PB0 PWM, UART wiring, external pull-down and the exact NUCLEO/module revision.
+
+Until valid persistent sequence storage, a provisioned device key, a valid persisted policy and a functioning link heartbeat are all provided, the MCU stays in a safe state and does not energize the PWM output.
+
+## Host tests
+
+From the repository root:
+
+```bash
+./firmware/stm32/tests/run_host_tests.sh
+```
+
+The host tests compile the portable C modules with GCC (`-Wall -Wextra -Werror -pedantic`) and verify the public interoperability vector with Python's standard `hmac` implementation. They do **not** compile the STM32 HAL adapter or the Mbed TLS source file.
+
+## Bring-up order
+
+1. Generate the NUCLEO-F411RE STM32CubeIDE project following `docs/CUBEIDE_SETUP.md`.
+2. Add `Core/Inc` and `Core/Src` files to the generated project; add `protocol/c` to compiler include paths.
+3. Wire early PB0 OFF, TIM3_CH3 PWM, USART1 RX/TX and the foreground adapter exactly as described in `docs/INTEGRATION_NOTES.md`.
+4. Build and flash with storage/key/policy providers still fail-closed. Confirm PWM remains OFF at reset, boot and UART disconnect.
+5. Select the FRAM part and implement the storage port before enabling any command that actuates output.
+6. Add Mbed TLS and a device-specific key provider; never use the public test vector key as a device key.
+7. Validate on the actual board with a low-voltage load/driver only.
diff --git a/firmware/stm32/docs/CUBEIDE_SETUP.md b/firmware/stm32/docs/CUBEIDE_SETUP.md
new file mode 100644
index 0000000000000000000000000000000000000000..9da56ee6e1b2504ebae630b74ea9b84e084b0fc5
--- /dev/null
+++ b/firmware/stm32/docs/CUBEIDE_SETUP.md
@@ -0,0 +1,97 @@
+# STM32CubeIDE setup — NUCLEO-F411RE
+
+This document describes the local CubeIDE project generation. A generated `.ioc` is deliberately not committed in this initial slice because the installed STM32CubeF4 package/CubeIDE version and board clock configuration have not been confirmed on the developer machine.
+
+## 1. Create the project
+
+1. Open STM32CubeIDE → **File → New → STM32 Project**.
+2. In **Board Selector**, search for `NUCLEO-F411RE` and select the matching board. If selecting by MCU instead, use `STM32F411RETx` and verify the package is for STM32F4.
+3. Set project name to `SENTINEL_X_STM32` and use the STM32CubeIDE toolchain.
+4. Keep the project in the SENTINEL-X workspace, preferably under `firmware/stm32/` (or create it there after ensuring the IDE does not overwrite the source folders).
+5. Choose C, not C++, and do not enable an RTOS in this initial bring-up.
+
+## 2. GPIO and fail-safe output
+
+**Baseline output:** `PB0 = TIM3_CH3`, low-voltage PWM only. The output is active-high in this proposed baseline.
+
+- Configure PB0 as `TIM3 Channel 3 PWM Generation CH3` (alternate function AF2).
+- Configure PWM mode 1, output polarity HIGH, fast mode disabled, and initial pulse/CCR = `0`.
+- Keep the timer output disabled until the application has forced CCR to zero.
+- `Core/Src/sx_stm32_adapter.c` calls `__HAL_TIM_SET_COMPARE(..., TIM_CHANNEL_3, 0)` before starting PWM.
+- Add an external pull-down (for example 10 kΩ) at the low-voltage driver input so the signal remains OFF while the MCU is reset or unpowered. Confirm the exact electrical design with the driver circuit.
+- Do not connect mains loads or drive an actuator directly from the MCU pin.
+
+Suggested PWM frequency: **1 kHz**, subject to the timer clock. Use:
+
+`f_PWM = f_TIM3 / ((PSC + 1) × (ARR + 1))`
+
+For example, if the actual TIM3 input clock is 84 MHz, `PSC=83` and `ARR=999` produce a 1 kHz PWM. Do not assume 84 MHz; calculate `PSC` from the clock tree configured in this `.ioc`.
+
+## 3. USART1
+
+Configure `USART1` in Asynchronous mode:
+
+| Parameter | Value |
+|---|---|
+| TX pin | PB6 / AF7 |
+| RX pin | PB7 / AF7 |
+| Baud | 115200 |
+| Word length | 8 bits |
+| Parity | None |
+| Stop bits | 1 |
+| Hardware flow control | None |
+| Oversampling | 16 |
+| RX interrupt | Enabled in NVIC |
+
+External wiring to ESP32-S3 is crossed:
+
+- STM32 PB6 / USART1_TX → ESP32-S3 UART RX (baseline GPIO18)
+- STM32 PB7 / USART1_RX ← ESP32-S3 UART TX (baseline GPIO17)
+- Common GND; both sides use 3.3 V logic.
+
+The ESP32-S3 GPIO mapping is proposed and must be checked against the exact DevKit board before wiring.
+
+## 4. Timer clock / PWM setup
+
+Configure TIM3 channel 3 as PWM1. The adapter calculates CCR from the configured ARR, so it does not assume a particular system-clock frequency. Set ARR/PSC so the resulting PWM frequency matches the output stage's requirements. Set initial CCR to zero in CubeMX and keep it zero in the generated initialization code.
+
+## 5. Other pins reserved by the Blueprint
+
+These are the current proposed assignments; they are not all used by this core slice:
+
+| Function | STM32 pin |
+|---|---|
+| TFT SPI2 SCK / MOSI / MISO | PB13 / PB15 / PB14 |
+| TFT CS / DC / RESET / BACKLIGHT | PB12 / PA9 / PC6 / PC7 |
+| FRAM I2C1 SCL / SDA | PB8 / PB9 |
+| RGB LED R / G / B | PA8 / PB1 / PA10 |
+| Buzzer | PB5 |
+| User button | PC13 |
+
+Do not configure these until checking for conflicts with the selected board, TFT/FRAM breakout and any debug interface.
+
+## 6. Compiler include paths and source files
+
+Add the shared protocol header directory to the compiler include paths:
+
+`../../protocol/c`
+
+Add the files from `firmware/stm32/Core/Inc` and `firmware/stm32/Core/Src` to the CubeIDE project. The portable host-tested core files are:
+
+- `sx_uart_frame.c`
+- `sx_envelope.c`
+- `sx_replay_guard.c`
+- `sx_app_core.c`
+- `sx_ring_buffer.c`
+
+The HAL-specific adapter `sx_stm32_adapter.c` requires the generated `main.h`, `huart1` and `htim3` handles.
+
+## 7. Mbed TLS
+
+Add a maintained Mbed TLS build compatible with the version selected for the project. The initial crypto adapter requires SHA-256/HMAC support (`MBEDTLS_MD_C` and `MBEDTLS_SHA256_C`) and the header `mbedtls/md.h`. Add the matching Mbed TLS include and source/library paths in CubeIDE.
+
+` sx_crypto_mbedtls.c` is intentionally excluded from the host GCC test target because Mbed TLS is not vendored in this repository. Target compilation must be recorded after the team selects and adds the exact Mbed TLS version/configuration.
+
+## 8. Generate code and verify
+
+Generate code, then integrate the adapter using `INTEGRATION_NOTES.md`. Do not start by sending an actuator command. First verify PB0 remains low at reset/boot and on UART timeout with a multimeter or oscilloscope and a safe low-voltage test circuit.
